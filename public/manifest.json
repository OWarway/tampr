{
  "manifest_version": 3,
  "name": "Tampr",
  "version": "0.1.0",
  "minimum_chrome_version": "138",
  "description": "Lightweight, local-first CSS and JavaScript browser mods.",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "storage",
    "userScripts"
  ],
  "optional_host_permissions": ["*://*/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Tampr"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "workspace.html",
    "open_in_tab": true
  }
}
