{
  "manifest_version": 3,
  "name": "Tampr",
  "version": "0.1.0",
  "minimum_chrome_version": "138",
  "description": "Lightweight, local-first CSS and JavaScript browser mods.",
  "permissions": ["activeTab", "storage", "userScripts"],
  "optional_permissions": ["downloads"],
  "optional_host_permissions": ["*://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tampr"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "workspace.html",
    "open_in_tab": true
  }
}
